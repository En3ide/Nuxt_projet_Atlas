# Configuration privée, utilisée uniquement par le serveur Nuxt.
NUXT_ATLAS_API_BASE=http://127.0.0.1:3002/api
# Même valeur que ATLAS_API_KEY dans ../atlas-backend/.env.
NUXT_ATLAS_API_KEY=replace-with-the-backend-api-key

# Terminal : console de la machine qui exécute Nuxt, accessible via localhost.
TERMINAL_MODE=local
TERMINAL_ENABLED=true
# Facultatif : dossier initial et chemin du shell (PowerShell / bash par défaut).
# TERMINAL_CWD=D:/Projet/TEST_techno/atlas-backend
# TERMINAL_SHELL=powershell.exe

# Pour utiliser une machine distante, choisir TERMINAL_MODE=ssh et configurer :
# SSH_HOST=192.168.1.10
# SSH_PORT=22
# SSH_USERNAME=atlas
# SSH_PASSWORD=
# Ou une clé privée, dont le chemin reste uniquement sur le serveur :
# SSH_PRIVATE_KEY_PATH=
# SSH_KEY_PASSPHRASE=
# Empreinte du serveur SSH vérifiée par un canal de confiance :
# SSH_HOST_FINGERPRINT=SHA256:...
